SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role (secreta). Solo aquí, nunca en el frontend.
SUPABASE_SERVICE_KEY=
# anthropic o gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Uno o varios separados por comas: si uno falla (cuota, saturación) se usa el siguiente.
LLM_MODEL=claude-opus-5-5
ALLOWED_ORIGIN=http://localhost:5173
# Opcional: token de GitHub (sin permisos) para pasar de 60 a 5000 consultas por hora
GITHUB_TOKEN=
