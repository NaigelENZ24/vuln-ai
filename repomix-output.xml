<file path="frontend/src/styles/analisis.css">
.analisis {
  min-height: 100vh;
}

.analisis__contenedor {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 16px clamp(16px, 4vw, 32px) 48px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.analisis__rejilla {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 430px;
  gap: 28px;
  align-items: start;
}

.analisis__principal {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

@media (max-width: 1000px) {
  .analisis__rejilla {
    grid-template-columns: 1fr;
  }
}

/* ---------- Barra de URL ---------- */
.barra-repo {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.barra-repo__campo {
  position: relative;
  flex: 1 1 320px;
  display: flex;
  align-items: center;
}

.barra-repo__campo svg {
  position: absolute;
  left: 14px;
  color: var(--muted);
  pointer-events: none;
}

.barra-repo input {
  width: 100%;
  min-height: 42px;
  padding: 0 14px 0 42px;
  font-family: var(--mono);
  font-size: 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.barra-repo input::placeholder {
  color: #6b7480;
}

.barra-repo input:focus-visible {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.barra-repo__error {
  flex-basis: 100%;
  font-size: 13px;
  color: #ff6b6b;
}

.btn-primario {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 16px;
  font-weight: 500;
  color: #d6f5e8;
  background: var(--accent-strong);
  border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  border-radius: 10px;
  cursor: pointer;
}

.btn-primario:hover {
  background: #1f7d5e;
}

/* ---------- Datos del repositorio ---------- */
.repo__titulo {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12px;
}

.repo__titulo h1 {
  font-family: var(--mono);
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.repo__enlace {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  color: var(--muted);
  text-decoration: none;
}

.repo__enlace:hover {
  color: var(--text);
}

.repo__meta {
  margin-top: 6px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 14px;
  font-size: 13px;
  color: var(--muted);
}

.repo__meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.repo__aviso {
  font-size: 14px;
  color: var(--muted);
}

/* ---------- Estado: análisis pendiente ---------- */
.pendiente {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 48px 24px;
  text-align: center;
  background: var(--surface);
  border: 1px dashed var(--border);
  border-radius: 16px;
}

.pendiente svg {
  color: var(--accent);
}

.pendiente h2 {
  font-size: 18px;
  font-weight: 500;
}

.pendiente p {
  max-width: 480px;
  font-size: 14px;
  color: var(--muted);
}

/* ---------- Riesgo global e interpretación (cuando haya resultados) ---------- */
