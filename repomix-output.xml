  --muted: #9aa3ad;
  --accent: #3ecf8e;
  --accent-ink: #08140e;
  --radius: 12px;
  --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --mono: ui-monospace, 'SFMono-Regular', Consolas, monospace;
